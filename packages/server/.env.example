# TredPOS Production Governance Template
# ---------------------------------------------------------
# postoperative posture: industrial_vanguard

# [Node Context]
NODE_ENV=production
PORT=9000
HOST=pos.tredpos.com

# [Identity Protocol]
PRIVATE_KEY=your_production_secret_key_change_me
GOOGLE_CLIENT_ID=your_google_id.apps.googleusercontent.com

# [Security Policy]
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://pos.tredpos.com,https://admin.tredpos.com

# [Database Cluster]
DB_HOST=127.0.0.1
DB_USER=tredpos_admin
DB_PASSWORD=secure_password
DB_NAME=tred_hardware

# [Institutional Mailer]
FROM_EMAIL=tredumollc@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PASS=your_app_password
SMTP_PORT=465
SMTP_USER=tredumollc@gmail.com
