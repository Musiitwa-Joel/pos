{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./index.ts & tailwindcss -i src/input.css -o src/index.css --watch",
    "dev:host": "bun --hot ./index.ts --host & tailwindcss -i src/input.css -o src/index.css --watch",
    "build": "tailwindcss -i src/input.css -o src/index.css && vite build",
    "clean": "rm -rf dist src/index.css",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@legendapp/state": "^2.1.15",
    "@react-oauth/google": "^0.13.4",
    "@types/apollo-upload-client": "^17.0.0",
    "@types/uuid": "^11.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "gsap": "^3.14.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react-fast-marquee": "^1.6.5",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "recharts": "2.13.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/bun": "^1.3.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.9"
  }
}
